rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.admin == true; }
    match /inquiries/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','email','subject','message'])
        && request.resource.data.name is string && request.resource.data.name.size() > 1 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 160
        && request.resource.data.subject is string && request.resource.data.subject.size() > 1 && request.resource.data.subject.size() <= 160
        && request.resource.data.message is string && request.resource.data.message.size() > 1 && request.resource.data.message.size() <= 4000;
      allow read, update, delete: if isAdmin();
    }
    match /{collection}/{id} {
      allow read: if collection in ['services','team','products','social','site'] && (resource.data.published == true || collection == 'site' || isAdmin());
      allow write: if isAdmin();
    }
  }
}
